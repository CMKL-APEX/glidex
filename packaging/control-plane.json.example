{
  "listen": ["0.0.0.0:8841", "[::]:8841"],
  "tls": "auto",
  "ui_user": "glidex-ui",
  "users_group": "glidex-users",
  "admin_group": "glidex-admin",
  "auth": {
    "allowed_origins": [],
    "session": { "idle_minutes": 30, "absolute_hours": 12 },
    "tokens": { "default_days": 90, "max_days": 365 },
    "pam": {
      "enabled": true,
      "allowed_groups": ["glidex-users"],
      "jit": true,
      "group_teams": {},
      "authd_socket": "/run/glidex-authd/auth.sock",
      "service": "glidex"
    },
    "oidc": {
      "enabled": false,
      "issuer": "",
      "client_id": "",
      "scopes": ["openid", "profile", "email", "groups"],
      "groups_claim": "groups",
      "jit": true,
      "allowed_domains": [],
      "required_groups": [],
      "group_teams": {}
    }
  },
  "authz": { "policy_files_dir": "/etc/glidex/policies", "policy_history": 50 },
  "quotas": {
    "default": {
      "vms": null, "vcpus": null, "memory_mib": null, "disk_gib": null,
      "running_vms": null, "networks": 2
    }
  },
  "pci": { "allow": [] },
  "audit": { "retention_days": 90 },
  "reconcile": {
    "vm_runner": "auto",
    "workers": 4,
    "resync_secs": 30,
    "on_host_boot": "resume",
    "host_shutdown_grace_secs": 60
  },
  "console": { "log_max_bytes": 16777216 },
  "metering": {
    "enabled": true,
    "sample_secs": 30,
    "storage_secs": 900,
    "close_grace_secs": 120,
    "retention_days": 400,
    "retention_daily_days": 1825,
    "retention_rate_days": 100
  }
}
