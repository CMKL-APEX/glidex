[Unit]
Description=glidex network helper (Open vSwitch, NAT, VM ports)
Documentation=https://github.com/akkarit/glidex/blob/main/spec/networking.md
# Open vSwitch must be up first; whichever of these exists is used
# (Debian/Ubuntu, Fedora, or glidex's source build). Missing ones are ignored.
Wants=network-online.target openvswitch-switch.service openvswitch.service glidex-ovs-vswitchd.service
After=network-online.target openvswitch-switch.service openvswitch.service ovs-vswitchd.service glidex-ovs-vswitchd.service
# Docker sets iptables FORWARD to DROP; start after it so DOCKER-USER
# exists when the NAT pass-through is restored (ignored without Docker).
After=docker.service ufw.service
Before=glidex-control-plane.service

[Service]
# READY=1 is sent once startup reconciliation is done and both sockets are
# bound: bridges re-created, DPDK NICs re-bound to vfio-pci, IP migrations
# re-applied, NAT (address, nftables, dnsmasq) restored.
Type=notify
ExecStart=/usr/local/bin/glidex-netd
RuntimeDirectory=glidex
RuntimeDirectoryMode=0755
# vhost-user sockets of running VMs live under /run/glidex/vhost. They must
# survive a netd restart, or OVS can never reconnect to those VMs.
RuntimeDirectoryPreserve=yes
StateDirectory=glidex
Restart=on-failure
RestartSec=2
TimeoutStartSec=180
# netd never needs /home, /root or /run/user (state is in /var/lib/glidex,
# source builds in /var/lib/glidex/build and /opt/glidex).
ProtectHome=yes
# No CapabilityBoundingSet on purpose: besides network administration
# (CAP_NET_ADMIN, CAP_NET_RAW), sysfs driver binds and vfio (CAP_SYS_ADMIN)
# and socket/directory ownership (CAP_CHOWN, CAP_FOWNER, CAP_DAC_OVERRIDE),
# the install_ovs op runs apt/dnf and their maintainer scripts, which may
# need any capability (creating users, setting file capabilities, restarting
# services). A bounding set would make package installs fail in ways that
# depend on the package. The netd.json policy decides who may ask for it.

[Install]
WantedBy=multi-user.target
