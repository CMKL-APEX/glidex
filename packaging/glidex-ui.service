[Unit]
Description=glidex web UI (serves the UI, proxies /api to the control plane)
Documentation=https://github.com/CMKL-APEX/glidex
Wants=glidex-control-plane.service
After=network-online.target glidex-control-plane.service

[Service]
Type=simple
User=glidex
Group=glidex
Environment=GLIDEX_UI_DIR=/usr/local/share/glidex/ui
# Loopback only (default), like the API it proxies. To expose it, set e.g.
# Environment=GLIDEX_UI_LISTEN=0.0.0.0:5173 in a drop-in; anyone who can
# reach it can manage every VM.
ExecStart=/usr/local/bin/glidex-ui
# It only reads the UI files and talks HTTP to the control plane.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
