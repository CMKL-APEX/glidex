[Unit]
Description=glidex web UI (serves the UI, proxies /api to the control plane)
Documentation=https://github.com/CMKL-APEX/glidex
Wants=glidex-control-plane.service
After=network-online.target glidex-control-plane.service

[Service]
Type=simple
# Its own user: it may use the control plane's ui.sock (sessions and tokens
# only, spec/security.md §5.6) and nothing else.
User=glidex-ui
Group=glidex-ui
Environment=GLIDEX_UI_DIR=/usr/local/share/glidex/ui
Environment=GLIDEX_API_SOCKET=/run/glidex-cp/ui.sock
# HTTPS on every address, port 5173 (spec/security.md §5.1). Without a
# configured certificate it generates a self-signed one in its state
# directory and logs the fingerprint. Users still log in; the UI holds no
# rights of its own. To use a real certificate, in a drop-in set
#   Environment=GLIDEX_UI_TLS_CERT=/etc/glidex/tls/ui.crt
#   LoadCredential=ui-tls-key:/etc/glidex/tls/ui.key
# GLIDEX_UI_LISTEN (e.g. 10.0.0.5:5173) narrows the addresses, and
# GLIDEX_UI_HOSTS replaces the default Host allowlist (this host's names
# and addresses).
StateDirectory=glidex-ui
StateDirectoryMode=0700
ExecStart=/usr/local/bin/glidex-ui
# It only reads the UI files and talks to the control plane.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# netd's socket, the control plane's data and authd's socket are not its
# business (/run/glidex-cp stays reachable for ui.sock).
InaccessiblePaths=-/run/glidex -/var/lib/glidex-control-plane -/run/glidex-authd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
