[Unit]
Description=glidex web UI (serves the UI, proxies /api to the control plane)
Documentation=https://github.com/CMKL-APEX/glidex
Wants=glidex-control-plane.service
After=network-online.target glidex-control-plane.service

[Service]
Type=simple
User=glidex
Group=glidex
Environment=GLIDEX_UI_DIR=/usr/local/share/glidex/ui
# The control plane's ui.sock only accepts the glidex-ui user
# (spec/security.md §5.6). Until this unit runs as that user, talk to the
# control plane over loopback TCP instead (browsers' session cookies are
# passed through either way).
Environment=GLIDEX_API_URL=http://127.0.0.1:8841
# Loopback only (default). Exposing it needs TLS: in a drop-in set
#   Environment=GLIDEX_UI_LISTEN=0.0.0.0:8443
#   Environment=GLIDEX_UI_HOSTS=glidex.example.org
#   Environment=GLIDEX_UI_TLS_CERT=/etc/glidex/tls/ui.crt
#   LoadCredential=ui-tls-key:/etc/glidex/tls/ui.key
# and add the https origin to auth.allowed_origins in control-plane.json.
ExecStart=/usr/local/bin/glidex-ui
# It only reads the UI files and talks HTTP to the control plane.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
