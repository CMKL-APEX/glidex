# Rendered by glidex-install (@USER@, @HOME@, @BIN@, @GROUPS@ are filled in).
[Unit]
Description=glidex control plane (REST API for VMs, networks, credentials)
Documentation=https://github.com/CMKL-APEX/glidex
# Networking is optional: start after glidex-netd if it is installed, but
# don't fail without it (VMs without networks still work). PAM logins go
# through glidex-authd (socket-activated; optional too).
Wants=glidex-netd.service glidex-authd.socket
After=network-online.target glidex-netd.service glidex-authd.socket

[Service]
Type=simple
# The glidex system user; its primary group also opens glidex-netd's and
# glidex-authd's sockets. No human is in this group (spec/security.md §4).
User=@USER@
Group=glidex
# kvm for /dev/kvm (left out when the group doesn't exist).
SupplementaryGroups=@GROUPS@
Environment=HOME=@HOME@
WorkingDirectory=@HOME@
ExecStart=@BIN@
# Listens on loopback TCP and on /run/glidex-cp/{api,ui}.sock. Settings
# (listeners, TLS, PAM, OIDC) are in /etc/glidex/control-plane.json; see
# control-plane.json.example. A non-loopback listener needs TLS, or the
# control plane refuses to start.
# Each VM runs in its own glidex-vm unit: stopping, restarting or upgrading
# this service leaves them running (spec/reconciliation.md D1/D2).
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=on-failure
# systemd counts death by SIGHUP as clean, so on-failure alone wouldn't
# restart after a stray one (the binary also ignores it).
RestartForceExitStatus=SIGHUP
RestartSec=2

# Runtime files (spec/security.md §9): api.sock and ui.sock in
# /run/glidex-cp (0755 so glidex-users and glidex-ui reach their socket;
# each socket checks its peer), per-VM directories in vms/<id>/ (0700:
# launch.json, instance.json, the shim, hypervisor API and console sockets,
# console log, cloud-init seed). Must survive this unit stopping: running
# VMs' shims live there.
RuntimeDirectory=glidex-cp
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
# Nothing the control plane creates is for anyone else: consoles are
# reached through the API (vm.console), not the raw sockets.
UMask=0077

# Credentials (spec/security.md §13): secrets are not put in
# control-plane.json or the environment. Uncomment in a drop-in
# (systemctl edit glidex-control-plane) for the features you use; systemd
# copies each file into $CREDENTIALS_DIRECTORY, readable only by this unit.
#LoadCredential=tls-key:/etc/glidex/tls/cp.key
#LoadCredential=oidc-client-secret:/etc/glidex/oidc-client-secret

# Sandbox (spec/reconciliation.md §13.3). Hypervisors run in the
# glidex-vm units with their own sandbox (and keep cloud-hypervisor's
# CAP_NET_ADMIN there); this unit runs none, so it closes /dev and sets
# no_new_privs. Its remaining children are disk tools (qemu-img, qemu-io,
# sgdisk, growpart, mkdosfs, mcopy). The detached VM runner can't work in
# here, and the control plane refuses to start with it.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# The service home holds the database, images, disks, firmware and logs.
# Disk images and kernels given to the API must be outside /home, /root
# and /run/user (ProtectHome).
ProtectHome=yes
ReadWritePaths=@HOME@
DevicePolicy=closed
# Unix sockets (API, netd, authd, D-Bus, shims, hypervisor APIs) and TCP
# (the API listeners, image downloads, OIDC).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
