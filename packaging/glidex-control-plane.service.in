# Rendered by glidex-install (@USER@, @HOME@, @BIN@, @GROUPS@ are filled in).
[Unit]
Description=glidex control plane (REST API for VMs, networks, credentials)
Documentation=https://github.com/CMKL-APEX/glidex
# Networking is optional: start after glidex-netd if it is installed, but
# don't fail without it (VMs without networks still work).
Wants=glidex-netd.service
After=network-online.target glidex-netd.service

[Service]
Type=simple
# The glidex system user; its primary group also opens glidex-netd's socket.
User=@USER@
Group=glidex
# kvm for /dev/kvm (left out when the group doesn't exist).
SupplementaryGroups=@GROUPS@
# Console sockets and logs are group-accessible, so members of the glidex
# group can `gxctl connect`.
UMask=0007
Environment=HOME=@HOME@
WorkingDirectory=@HOME@
ExecStart=@BIN@
# Listen on loopback only (default). To expose the unauthenticated API,
# set e.g. Environment=GLIDEX_LISTEN=0.0.0.0:8841 in a drop-in.
# Stopping the service stops running VMs (the control plane's shutdown).
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=on-failure
# systemd counts death by SIGHUP as clean, so on-failure alone wouldn't
# restart after a stray one (the binary also ignores it).
RestartForceExitStatus=SIGHUP
RestartSec=2

[Install]
WantedBy=multi-user.target
