// Cedar schema for glidex authorization (spec/security.md §7.1).
//
// Every API route maps to exactly one concrete action below. Roles and
// permission groups are action groups and are never requested directly.
namespace Glidex {
  type Auth = {
    method: String,        // "peer" | "pam" | "oidc" | "token" | "disabled"
    transport: String,     // "unix" | "tcp"
    age_secs: Long,        // seconds since this principal last authenticated
    mfa: Bool,             // a multi-factor login (a session from an MFA'd connector)
    source_ip?: ipaddr,    // TCP clients (from X-Forwarded-For only via glidex-ui)
  };
  // Every request is decided for one cluster (or directory) by one control
  // plane; `tenant` is the tenant owning the resource, when it has one
  // (spec/tenancy.md §10).
  type Ctx = { auth: Auth, cluster?: Cluster, directory?: Directory, tenant?: Tenant };
  type ProjectCtx = { auth: Auth, cluster?: Cluster, directory?: Directory, tenant?: Tenant, project: Project };
  type NetworkCtx = { auth: Auth, cluster?: Cluster, directory?: Directory, tenant?: Tenant, network: Network };

  // Directories hold tenants, users and teams (spec/tenancy.md D2); a user
  // or team is `in` each tenant it is a member of (D3).
  entity Directory { owner: Tenant };
  entity Tenant in [Directory] {
    directory: Directory, owns_directory: Bool, operator: Bool, suspended: Bool,
    clusters: Set<Cluster>,
  };
  // A standalone host is a cluster of one: Host::"local" in Cluster::"local".
  // System roles link to the Cluster and so cover every host; host-specific
  // actions (OVS, uplinks, PCI devices, host paths) take the node's Host, so
  // a grant can be limited to one node (spec/clustering.md §12.2).
  entity Cluster { operator: Tenant, admitted: Set<Tenant> };
  entity Host in [Cluster];
  entity Team in [Tenant];
  entity User in [Team, Tenant] { disabled: Bool };
  entity Token in [Tenant] { owner?: User, expired: Bool };   // personal (owner) or service account
  // A project is in its tenant and in the cluster deciding the request,
  // so cluster roles cover the projects that use the cluster (§10.1).
  entity Project in [Cluster, Tenant] { tenant: Tenant };
  entity Vm in [Project] { project: Project };
  entity Disk in [Project] { project: Project };
  entity Credential in [Project] { project: Project };
  entity Image in [Cluster];
  // Where disks live (spec/storage.md §13); `local` is built in.
  entity Datastore in [Cluster];
  // Host networks: parent Cluster, no `project`. Project networks: parent Project.
  // shares: projects that accepted a share of a project network.
  // tenant_grants: tenants whose every project may use a host network or
  // a device (spec/tenancy.md D25).
  entity Network in [Cluster, Project] {
    project?: Project, all_projects: Bool, grants: Set<Project>, shares: Set<Project>,
    tenant_grants: Set<Tenant>,
  };
  entity PciDevice in [Host] { grants: Set<Project>, tenant_grants: Set<Tenant> };
  // A pool of devices, asked for by count (spec/host-topology.md §9).
  entity PciPool in [Cluster] { grants: Set<Project>, tenant_grants: Set<Tenant> };

  // Marker groups (spec/tenancy.md §10): every concrete action is in
  // exactly one of these; base.cedar bounds who can ever pass each.
  action "tenant-scoped";
  action "host-scoped";
  action "directory-scoped";
  action "shared";

  // Roles are action groups. A role includes every role listed under it.
  action "role.system-admin";
  action "role.tenant-admin";
  action "role.directory-admin";
  action "role.tenant-auditor" in ["role.tenant-admin"];
  action "role.directory-auditor" in ["role.directory-admin"];
  action "role.owner" in ["role.system-admin", "role.tenant-admin"];
  action "role.auditor", "role.net-admin", "role.image-admin" in ["role.system-admin"];
  action "role.editor"   in ["role.owner"];
  action "role.operator" in ["role.editor"];
  action "role.viewer"   in ["role.operator", "role.auditor", "role.tenant-auditor"];

  // Marker group: everything in it needs a recent login (base.step-up).
  action "step-up";

  // Permission groups (spec §7.2).
  action "project.read", "vm.read", "disk.read", "usage.read" in ["role.viewer"];
  action "vm.operate", "vm.console" in ["role.operator"];
  action "vm.write", "disk.write", "credential.read", "credential.write",
         "network.use" in ["role.editor"];
  action "project.members", "network.manage", "network.share" in ["role.owner"];
  action "host.read" in ["role.auditor", "role.net-admin"];
  // Cluster membership and recovery (spec/clustering.md §12.2). Tokens, joins
  // and snapshots are secrets or irreversible, so they need a recent login.
  action "host.cluster" in ["role.system-admin"];
  action "node.drain" in ["role.system-admin"];
  action "host.cluster.critical" in ["host.cluster", "step-up"];
  action "policy.read", "system.audit", "system.usage" in ["role.auditor"];
  action "host.network", "host.devices" in ["role.net-admin"];
  action "host.network.critical" in ["host.network", "step-up"];
  action "image.manage" in ["role.image-admin"];
  action "datastore.manage" in ["role.system-admin"];
  action "policy.write" in ["role.system-admin", "step-up"];
  action "host.paths", "quota.exceed", "cluster.admissions", "cluster.directories" in ["role.system-admin"];
  // Tenants and directories (spec/tenancy.md §10.5).
  action "tenant.read" in ["role.tenant-auditor"];
  action "tenant.members", "tenant.projects", "tenant.federations", "tenant.clusters" in ["role.tenant-admin"];
  action "directory.read" in ["role.directory-auditor"];
  action "directory.users", "directory.tenants", "directory.connectors", "directory.keys" in ["role.directory-admin"];

  // ---- usage (spec/metering.md §10) ----------------------------------------
  action readUsage in ["system.usage", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Cluster], context: Ctx };
  action readProjectUsage in ["usage.read", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Project], context: Ctx };
  action readVmUsage in ["usage.read", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Vm], context: Ctx };
  action readDiskUsage in ["usage.read", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Disk], context: Ctx };
  // Labels of host-or-project reports; handlers scope them like readUsage.
  action readBandwidth, readDiskIoUsage, readComputeUsage in ["system.usage", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Cluster], context: Ctx };
  action readVmBandwidth, readVmIo, readVmCompute in ["usage.read", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Vm], context: Ctx };
  action readVmStats in ["vm.read", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Vm], context: Ctx };
  action readDiskIo in ["usage.read", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Disk], context: Ctx };
  // Traffic is tenant data: project networks for project members, host
  // networks for host roles (auditor).
  action readNetworkBandwidth, readNetworkStats in ["usage.read", "shared"]
    appliesTo { principal: [User, Token], resource: [Network], context: Ctx };

  // ---- projects ----------------------------------------------------------
  action readProject, readBindings in ["project.read", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Project], context: Ctx };
  action manageBindings, manageServiceTokens, readProjectAudit in ["project.members", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Project], context: Ctx };
  action updateProject, deleteProject in ["tenant.projects", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Project], context: Ctx };
  action createProject in ["tenant.projects", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Tenant], context: Ctx };
  action manageSystemBindings in ["role.system-admin", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Cluster], context: Ctx };
  action readSystemBindings in ["policy.read", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Cluster], context: Ctx };
  action exceedQuota in ["quota.exceed", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Project], context: Ctx };

  // ---- tenants and admissions (spec/tenancy.md §14) -------------------------
  action listTenants in ["directory.read", "directory-scoped"]
    appliesTo { principal: [User, Token], resource: [Directory], context: Ctx };
  action createTenant in ["directory.tenants", "directory-scoped"]
    appliesTo { principal: [User, Token], resource: [Directory], context: Ctx };
  action updateTenant, suspendTenant, resumeTenant in ["directory.tenants", "directory-scoped"]
    appliesTo { principal: [User, Token], resource: [Tenant], context: Ctx };
  action deleteTenant in ["directory.tenants", "step-up", "directory-scoped"]
    appliesTo { principal: [User, Token], resource: [Tenant], context: Ctx };
  // Directory admins see and bootstrap every tenant of their directory.
  action readTenant, readTenantMembers, readTenantBindings in ["tenant.read", "directory.read", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Tenant], context: Ctx };
  action manageTenantMembers, manageTenantBindings in ["tenant.members", "directory.tenants", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Tenant], context: Ctx };
  // Invitations (spec/tenancy.md §6.1) name an email address: listed only
  // to those who may invite.
  action readTenantInvitations, manageTenantInvitations in ["tenant.members", "directory.tenants", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Tenant], context: Ctx };
  // Tenant pools (spec/host-topology.md §9.1a): a tenant's share of a
  // cluster device pool, split among its projects.
  action readTenantDevicePools in ["tenant.read", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Tenant], context: Ctx };
  action manageTenantDevicePools in ["tenant.projects", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Tenant], context: Ctx };
  // Workload federations (spec/tenancy.md §9, D51): trusting a CI system
  // gives its jobs a service account's rights in the tenant.
  action readTenantFederations in ["tenant.read", "tenant.federations", "directory.read", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Tenant], context: Ctx };
  action manageTenantFederations in ["tenant.federations", "directory.tenants", "step-up", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Tenant], context: Ctx };
  // Clusters of other organizations a tenant uses (spec/tenancy.md D65).
  action readTenantClusters in ["tenant.read", "tenant.clusters", "directory.read", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Tenant], context: Ctx };
  action manageTenantClusters in ["tenant.clusters", "step-up", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Tenant], context: Ctx };
  // ---- directory connectors (spec/tenancy.md §5, T1) ------------------------
  action listConnectors, readConnector in ["directory.read", "directory-scoped"]
    appliesTo { principal: [User, Token], resource: [Directory], context: Ctx };
  action createConnector, updateConnector, deleteConnector, setConnectorSecret in ["directory.connectors", "step-up", "directory-scoped"]
    appliesTo { principal: [User, Token], resource: [Directory], context: Ctx };
  action testConnector in ["directory.connectors", "directory-scoped"]
    appliesTo { principal: [User, Token], resource: [Directory], context: Ctx };
  // The directory's token signing keys (spec/tenancy.md D53).
  action readSigningKeys in ["directory.read", "directory-scoped"]
    appliesTo { principal: [User, Token], resource: [Directory], context: Ctx };
  action rotateSigningKey in ["directory.keys", "step-up", "directory-scoped"]
    appliesTo { principal: [User, Token], resource: [Directory], context: Ctx };
  // SCIM bearer tokens (spec/tenancy.md §8.1): who holds one provisions
  // the connector's users.
  action readScimTokens in ["directory.read", "directory-scoped"]
    appliesTo { principal: [User, Token], resource: [Directory], context: Ctx };
  action manageScimTokens in ["directory.connectors", "step-up", "directory-scoped"]
    appliesTo { principal: [User, Token], resource: [Directory], context: Ctx };
  // A pull now (spec/tenancy.md §8.2); confirming one the safety stop
  // blocked (D46) disables many users at once.
  action syncConnector in ["directory.connectors", "directory-scoped"]
    appliesTo { principal: [User, Token], resource: [Directory], context: Ctx };
  action confirmConnectorSync in ["directory.connectors", "step-up", "directory-scoped"]
    appliesTo { principal: [User, Token], resource: [Directory], context: Ctx };
  // Directories the host serves (spec/tenancy.md D59): the operator's.
  action listDirectories in ["host.read", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Cluster], context: Ctx };
  action manageDirectories in ["cluster.directories", "step-up", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Cluster], context: Ctx };
  action listAdmissions in ["host.read", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Cluster], context: Ctx };
  action manageAdmissions in ["cluster.admissions", "step-up", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Cluster], context: Ctx };
  // Every allocation on a cluster (compound request, §10.4): only where the
  // project's tenant is admitted (base.admission).
  action useCluster in ["shared"]
    appliesTo { principal: [User, Token], resource: [Cluster], context: ProjectCtx };

  // ---- VMs ---------------------------------------------------------------
  action readVm, getConsoleInfo in ["vm.read", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Vm], context: Ctx };
  action listVms in ["vm.read", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Project], context: Ctx };
  // updateVm: PATCH of spec fields other than power, devices, disks and
  // networks (spec/reconciliation.md §12.1).
  // Placing a VM on another node is the cluster operator's (spec/storage.md S10).
  action placeVm in ["node.drain", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Vm], context: Ctx };
  action startVm, stopVm, pauseVm, updateVm in ["vm.operate", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Vm], context: Ctx };
  action openConsole in ["vm.console", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Vm], context: Ctx };
  action createVm in ["vm.write", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Project], context: Ctx };
  action deleteVm, attachDisk, detachDisk, attachDevice, detachDevice in ["vm.write", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Vm], context: Ctx };
  action useDisk in ["vm.write", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Disk], context: ProjectCtx };
  action useCredential in ["vm.write", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Credential], context: ProjectCtx };
  // Giving a VM a service account (workload-identity.md W5): on the service
  // account's project, with those who manage its service tokens;
  // context.project is the VM's.
  action useServiceAccount in ["project.members", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Project], context: ProjectCtx };
  action prepareDevice, releaseDevice, cordonDevice, setSriovVfs in ["host.devices", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Host], context: Ctx };
  action usePciPool in ["host.devices", "shared"]
    appliesTo { principal: [User, Token], resource: [PciPool], context: ProjectCtx };
  action usePciDevice in ["host.devices", "shared"]
    appliesTo { principal: [User, Token], resource: [PciDevice], context: ProjectCtx };
  action useHostPath in ["host.paths", "shared"]
    appliesTo { principal: [User, Token], resource: [Host], context: Ctx };

  // ---- disks and guest credentials ---------------------------------------
  action listDisks in ["disk.read", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Project], context: Ctx };
  action readDisk in ["disk.read", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Disk], context: Ctx };
  action createDisk in ["disk.write", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Project], context: Ctx };
  action deleteDisk, resizeDisk, extendRoot, moveDisk in ["disk.write", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Disk], context: Ctx };
  action listCredentials in ["credential.read", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Project], context: Ctx };
  action readCredential in ["credential.read", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Credential], context: Ctx };
  action createCredential in ["credential.write", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Project], context: Ctx };
  action updateCredential, deleteCredential in ["credential.write", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Credential], context: Ctx };

  // ---- networks ----------------------------------------------------------
  action attachNetwork, detachNetwork in ["network.use", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Vm, Project], context: Ctx };
  action useNetwork in ["shared"]  // in no group: who may attach is `attachNetwork`
    appliesTo { principal: [User, Token], resource: [Network], context: ProjectCtx };
  action createProjectNetwork in ["network.manage", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Project], context: Ctx };
  action deleteProjectNetwork in ["network.manage", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Network], context: Ctx };
  // VPC routers (spec/clustering.md §11.2a), on the owning project.
  action createRouter, deleteRouter in ["network.manage", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Project], context: Ctx };
  action readRouter in ["project.read", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Project], context: Ctx };
  // Source side, on the network; context.project is the target project.
  action offerNetworkShare, unshareNetwork in ["network.share", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Network], context: ProjectCtx };
  // Target side, on the target project.
  action acceptNetworkShare, leaveNetworkShare in ["network.share", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Project], context: NetworkCtx };
  action listNetworkShares in ["network.share", "tenant-scoped"]
    appliesTo { principal: [User, Token], resource: [Project], context: Ctx };

  // ---- host --------------------------------------------------------------
  // readSystemStatus: GET /system/reconcile (spec/reconciliation.md §12.5).
  action readOvsStatus, listBridges, listUplinks, listPciDevices, listPciPools, readHostTopology, readSystemStatus in ["host.read", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Host], context: Ctx };
  action createNetwork, createBridge, ensureUplink in ["host.network", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Host], context: Ctx };
  action deleteNetwork, grantNetwork in ["host.network", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Network], context: Ctx };
  action installOvs, initDpdk, confirmUplink, commitUplink, deleteUplink, deleteBridge in ["host.network.critical", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Host], context: Ctx };

  // ---- cluster (spec/clustering.md §5) ---------------------------------------
  action readCluster in ["host.read", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Cluster], context: Ctx };
  action initCluster, joinCluster, importCluster, rejoinCluster, leaveCluster in ["host.cluster.critical", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Host], context: Ctx };
  action createJoinToken, promoteNode, snapshotCluster in ["host.cluster.critical", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Cluster], context: Ctx };
  // Membership (spec/clustering.md §5.5-5.7).
  action removeNode, forgetNode, purgeNode, createRejoinToken, rotateCa, rotateSecretsKey, detachNode, approveImport, rejectImport, dissolveCluster in ["host.cluster.critical", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Cluster], context: Ctx };
  // OVN as a cluster setting (spec/clustering-ui.md §8a).
  action configureOvn in ["host.cluster.critical", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Cluster], context: Ctx };

  // ---- nodes (spec/clustering.md §7) -------------------------------------
  action listImports, readImport in ["host.read", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Cluster], context: Ctx };
  action listNodes in ["host.read", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Cluster], context: Ctx };
  action readNode in ["host.read", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Host], context: Ctx };
  action drainNode, undrainNode in ["node.drain", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Host], context: Ctx };
  // A node's own OVN options, e.g. its br-int datapath (spec/clustering.md §11.6).
  action configureNode in ["host.cluster.critical", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Host], context: Ctx };

  // ---- images ------------------------------------------------------------
  action readImage, readNetwork in ["shared"]
    appliesTo { principal: [User, Token], resource: [Cluster, Image, Network], context: Ctx };
  action pullImage in ["image.manage", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Cluster], context: Ctx };
  action deleteImage in ["image.manage", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Image], context: Ctx };

  // ---- datastores (spec/storage.md §13) ----------------------------------
  action readDatastore in ["shared"]
    appliesTo { principal: [User, Token], resource: [Cluster, Datastore], context: Ctx };
  action manageDatastore in ["datastore.manage", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Cluster, Datastore], context: Ctx };
  // Putting a disk on it: permitted to all (base.use-datastore); a site
  // policy can forbid a datastore to some.
  action useDatastore in ["shared"]
    appliesTo { principal: [User, Token], resource: [Datastore], context: Ctx };

  // ---- identity, tokens, audit, policies ---------------------------------
  action listUsers, listTeams in ["directory.read", "directory-scoped"]
    appliesTo { principal: [User, Token], resource: [Directory], context: Ctx };
  action manageUsers, manageTeams, manageAnyTokens in ["directory.users", "directory-scoped"]
    appliesTo { principal: [User, Token], resource: [Directory], context: Ctx };
  action manageOwnTokens in ["shared"]
    appliesTo { principal: [User, Token], resource: [User], context: Ctx };
  // A user's own sign-in methods (spec/tenancy.md §6.2): adding or
  // removing one needs a recent login, so a stolen session can't add its
  // thief's account.
  action manageOwnSignIns in ["shared", "step-up"]
    appliesTo { principal: [User, Token], resource: [User], context: Ctx };
  action readAudit in ["system.audit", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Cluster], context: Ctx };
  action readPolicy, validatePolicy, simulatePolicy in ["policy.read", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Cluster], context: Ctx };
  action writePolicy, deletePolicy, reloadPolicies in ["policy.write", "host-scoped"]
    appliesTo { principal: [User, Token], resource: [Cluster], context: Ctx };
}
